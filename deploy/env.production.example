NODE_ENV=production
PORT=5001
SERVE_STATIC=true
STATIC_DIR=/var/www/crm-builder/artifacts/crm/dist/public

# Current application DB mode.
# The project currently runs on SQLite. Keep this for first deploy.
SQLITE_FILE=/var/www/crm-builder/data/crm.sqlite

SESSION_SECRET=replace-with-long-random-secret
BASE_PATH=/

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
